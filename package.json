{
  "name": "nemo-wrapper",
  "version": "1.0.0",
  "description": "",
  "main": "dist/main/index.js",
  "scripts": {
    "postinstall": "electron-rebuild -f -w node-pty || exit 0",
    "rebuild:pty": "electron-rebuild -f -w node-pty",
    "test": "echo \"Error: no test specified\" && exit 1",
    "init:tsconfig": "npx create-tsconfig @typescript-eslint/parser --project=src/main/index.ts",
    "setup:python": "python -m pip install -r python/requirements.txt",
    "check:python-deps": "python -m pip install -r python/requirements-dev.txt -q && python -m pip check && cd python && python -m deptry .",
    "build": "tsc -p ./ && npm run build --prefix src/renderer",
    "pack": "npm run build && node scripts/run-electron-builder.mjs",
    "pack:dir": "npm run build && node scripts/run-electron-builder.mjs --dir",
    "render:icon": "python scripts/render_clara_coder_icon.py",
    "start": "electron dist/main/index.js",
    "dev": "concurrently \"npm start --prefix src/renderer\" \"tsc -p ./ --watch --preserveWatchOutput\" \"wait-on http://localhost:4200 && cross-env DEV_SERVER_URL=http://localhost:4200 electronmon dist/main/index.js\"",
    "dev:lmstudio": "cross-env NEMO_LLM_PROVIDER=lmstudio NEMO_AUDIO_PROVIDER=openai npm run dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "electronmon": {
    "patterns": [
      "!**/__pycache__/**",
      "!**/*.pyc",
      "!**/*.pyo"
    ]
  },
  "dependencies": {
    "iconv-lite": "^0.6.3",
    "node-pty": "^1.1.0",
    "systeminformation": "^5.31.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.2",
    "@types/node": "^25.5.0",
    "@typescript-eslint/parser": "^8.57.3-alpha.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.0.4",
    "electron-builder": "^26.8.1",
    "electronmon": "^2.0.4",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "typescript": "5.8.3",
    "typescript-language-server": "^5.1.3",
    "wait-on": "^9.0.4"
  }
}
