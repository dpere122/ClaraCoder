{
  "name": "clara-coder",
  "version": "1.0.0",
  "description": "Clara Coder — Electron desktop app for AI-assisted coding",
  "main": "dist/main/index.js",
  "private": true,
  "packageManager": "npm@11.9.0",
  "scripts": {
    "postinstall": "node scripts/rebuild-native.mjs && node scripts/patch-monaco-vite-ignore.mjs",
    "rebuild:pty": "electron-rebuild -f -o node-pty",
    "rebuild:sqlite": "electron-rebuild -f -o better-sqlite3",
    "ng": "node scripts/run-ng.mjs",
    "test": "node scripts/run-ng.mjs test",
    "test:renderer": "node scripts/run-ng.mjs test",
    "setup:python": "node scripts/setup-python.mjs",
    "setup:python:cpu": "cross-env CLARA_PYTORCH_CPU=1 node scripts/setup-python.mjs",
    "check:python-deps": "python -m pip install -r python/requirements-dev.txt -q && python -m pip check && cd python && python -m deptry .",
    "build": "tsc -p ./ && node scripts/run-ng.mjs build",
    "pack": "npm run build && node scripts/run-electron-builder.mjs",
    "pack:dir": "npm run build && node scripts/run-electron-builder.mjs --dir",
    "render:icon": "python scripts/render_clara_coder_icon.py",
    "start": "node scripts/run-electron.mjs electron dist/main/index.js",
    "dev": "concurrently \"node scripts/run-ng.mjs serve --host 127.0.0.1\" \"tsc -p ./ --watch --preserveWatchOutput\" \"wait-on http://127.0.0.1:4200 && cross-env DEV_SERVER_URL=http://127.0.0.1:4200 node scripts/run-electron.mjs electronmon dist/main/index.js\"",
    "dev:lmstudio": "cross-env NEMO_LLM_PROVIDER=lmstudio NEMO_AUDIO_PROVIDER=openai npm run dev"
  },
  "keywords": [],
  "author": "Clara Coder <dev@clara.coder>",
  "desktopName": "clara-coder",
  "license": "ISC",
  "type": "commonjs",
  "electronmon": {
    "patterns": [
      "!**/__pycache__/**",
      "!**/*.pyc",
      "!**/*.pyo"
    ]
  },
  "dependencies": {
    "@angular/animations": "^21.2.6",
    "@angular/cdk": "^21.2.5",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/localize": "^21.2.6",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@ng-bootstrap/ng-bootstrap": "^20.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "better-sqlite3": "^12.9.0",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.5.1",
    "dompurify": "^3.4.9",
    "font-list": "^2.1.0",
    "highlight.js": "^11.11.1",
    "iconv-lite": "^0.6.3",
    "lucide-angular": "^1.0.0",
    "marked": "^17.0.5",
    "marked-highlight": "^2.2.3",
    "monaco-editor": "^0.52.2",
    "ngx-spinner": "^21.1.0",
    "node-pty": "^1.1.0",
    "prettier": "^3.8.1",
    "rxjs": "~7.8.0",
    "systeminformation": "^5.31.5",
    "tslib": "^2.3.0",
    "undici": "^6.25.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.5",
    "@angular/cli": "^21.2.5",
    "@angular/compiler-cli": "^21.2.0",
    "@electron/rebuild": "^4.0.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.0",
    "@typescript-eslint/parser": "^8.57.3-alpha.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.0.4",
    "electron-builder": "^26.8.1",
    "electronmon": "^2.0.4",
    "jsdom": "^28.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2",
    "typescript-language-server": "^5.1.3",
    "vitest": "^4.0.8",
    "wait-on": "^9.0.4"
  }
}
