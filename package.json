{
  "name": "nemo-wrapper",
  "version": "1.0.0",
  "description": "",
  "main": "dist/main/index.js",
  "scripts": {
    "postinstall": "node scripts/rebuild-native.mjs",
    "rebuild:pty": "electron-rebuild -f -o node-pty",
    "rebuild:sqlite": "electron-rebuild -f -o better-sqlite3",
    "test": "npm test --prefix src/renderer",
    "test:renderer": "npm test --prefix src/renderer",
    "setup:python": "node scripts/setup-python.mjs",
    "setup:python:cpu": "cross-env NEMO_PYTORCH_CPU=1 node scripts/setup-python.mjs",
    "check:python-deps": "python -m pip install -r python/requirements-dev.txt -q && python -m pip check && cd python && python -m deptry .",
    "build": "tsc -p ./ && npm run build --prefix src/renderer",
    "pack": "npm run build && node scripts/run-electron-builder.mjs",
    "pack:dir": "npm run build && node scripts/run-electron-builder.mjs --dir",
    "render:icon": "python scripts/render_clara_coder_icon.py",
    "start": "node scripts/run-electron.mjs electron dist/main/index.js",
    "dev": "concurrently \"npm start --prefix src/renderer\" \"tsc -p ./ --watch --preserveWatchOutput\" \"wait-on http://127.0.0.1:4200 && cross-env DEV_SERVER_URL=http://127.0.0.1:4200 node scripts/run-electron.mjs electronmon dist/main/index.js\"",
    "dev:lmstudio": "cross-env NEMO_LLM_PROVIDER=lmstudio NEMO_AUDIO_PROVIDER=openai npm run dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "electronmon": {
    "patterns": [
      "!**/__pycache__/**",
      "!**/*.pyc",
      "!**/*.pyo"
    ]
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "font-list": "^2.1.0",
    "iconv-lite": "^0.6.3",
    "node-pty": "^1.1.0",
    "prettier": "^3.8.1",
    "systeminformation": "^5.31.5",
    "undici": "^6.25.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.0",
    "@typescript-eslint/parser": "^8.57.3-alpha.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.0.4",
    "electron-builder": "^26.8.1",
    "electronmon": "^2.0.4",
    "ts-node": "^10.9.2",
    "typescript": "5.8.3",
    "typescript-language-server": "^5.1.3",
    "wait-on": "^9.0.4"
  }
}
