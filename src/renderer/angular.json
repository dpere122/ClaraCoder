{
  "$schema": "../../node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "renderer": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "../../dist/renderer",
            "baseHref": "./",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "loader": {
              ".ttf": "file",
              ".woff": "file",
              ".woff2": "file"
            },
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "../../node_modules/bootstrap/dist/css/bootstrap.min.css",
              "../../node_modules/ngx-spinner/animations/ball-triangle-path.css",
              "../../node_modules/ngx-spinner/animations/ball-atom.css",
              "../../node_modules/ngx-spinner/animations/line-scale.css",
              "../../node_modules/ngx-spinner/animations/ball-clip-rotate.css",
              "../../node_modules/ngx-spinner/animations/ball-clip-rotate-pulse.css",
              "../../node_modules/ngx-spinner/animations/ball-pulse-sync.css",
              "../../node_modules/ngx-spinner/animations/line-spin-fade.css",
              "../../node_modules/ngx-spinner/animations/ball-scale-multiple.css",
              "../../node_modules/@xterm/xterm/css/xterm.css",
              "../../node_modules/monaco-editor/min/vs/editor/editor.main.css",
              "src/styles.css",
              "src/app/features/chat/hitl-btn-shared.css"
            ]
          },
          "configurations": {
            "production": {
              "optimization": {
                "styles": {
                  "inlineCritical": false
                }
              },
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "3MB",
                  "maximumError": "4MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "18kB",
                  "maximumError": "24kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "renderer:build:production"
            },
            "development": {
              "buildTarget": "renderer:build:development",
              "prebundle": false
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
